import tensorflow as tf
import matplotlib.pyplot as plt


# =========================
# 1. DANE (MNIST)
# =========================
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

x_train_cnn = x_train.reshape(-1, 28, 28, 1).astype("float32") / 255.0
x_test_cnn  = x_test.reshape(-1, 28, 28, 1).astype("float32") / 255.0

y_train_oh = tf.keras.utils.to_categorical(y_train, 10)
y_test_oh  = tf.keras.utils.to_categorical(y_test, 10)


# =========================
# 2. MODEL - LeakyReLU
# =========================
def build_model_leaky():
    model = tf.keras.models.Sequential([
        tf.keras.layers.Input(shape=(28, 28, 1)),

        tf.keras.layers.Conv2D(32, (3,3)),
        tf.keras.layers.LeakyReLU(alpha=0.1),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Conv2D(64, (3,3)),
        tf.keras.layers.LeakyReLU(alpha=0.1),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Flatten(),

        tf.keras.layers.Dense(128),
        tf.keras.layers.LeakyReLU(alpha=0.1),

        tf.keras.layers.Dense(10, activation='softmax')
    ])
    return model


# =========================
# 3. MODEL - ELU
# =========================
def build_model_elu():
    model = tf.keras.models.Sequential([
        tf.keras.layers.Input(shape=(28, 28, 1)),

        tf.keras.layers.Conv2D(32, (3,3)),
        tf.keras.layers.ELU(alpha=1.0),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Conv2D(64, (3,3)),
        tf.keras.layers.ELU(alpha=1.0),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Flatten(),

        tf.keras.layers.Dense(128),
        tf.keras.layers.ELU(alpha=1.0),

        tf.keras.layers.Dense(10, activation='softmax')
    ])
    return model


# =========================
# 4. FUNKCJA TRENINGOWA
# =========================
def train_model(model):
    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
        loss='categorical_crossentropy',
        metrics=['accuracy']
    )

    history = model.fit(
        x_train_cnn, y_train_oh,
        epochs=5,
        batch_size=32,
        validation_split=0.2,
        verbose=1
    )

    return history


# =========================
# 5. TRENING MODELI
# =========================
print("\nTrening LeakyReLU...")
hist_leaky = train_model(build_model_leaky())

print("\nTrening ELU...")
hist_elu = train_model(build_model_elu())


# =========================
# 6. WYKRES PORÓWNAWCZY
# =========================
plt.figure(figsize=(10,5))

plt.plot(hist_leaky.history['val_accuracy'], label='LeakyReLU')
plt.plot(hist_elu.history['val_accuracy'], label='ELU')

plt.title("Zadanie C – LeakyReLU vs ELU")
plt.xlabel("Epoka")
plt.ylabel("Validation Accuracy")
plt.legend()
plt.grid(True)

plt.show()