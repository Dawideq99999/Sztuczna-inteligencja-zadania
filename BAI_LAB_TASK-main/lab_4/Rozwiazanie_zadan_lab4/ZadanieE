import tensorflow as tf
import matplotlib.pyplot as plt


# =========================
# 1. DANE (MNIST)
# =========================
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

x_train_cnn = x_train.reshape(-1, 28, 28, 1).astype("float32") / 255.0
x_test_cnn  = x_test.reshape(-1, 28, 28, 1).astype("float32") / 255.0

y_train_oh = tf.keras.utils.to_categorical(y_train, 10)


# =========================
# 2. AUGMENTACJA
# =========================
data_augmentation = tf.keras.Sequential([
    tf.keras.layers.RandomRotation(0.1),
    tf.keras.layers.RandomTranslation(0.1, 0.1),
    tf.keras.layers.RandomZoom(0.1),
])


# =========================
# 3. MODEL BEZ AUGMENTACJI
# =========================
def build_model_no_aug():
    return tf.keras.models.Sequential([
        tf.keras.layers.Input(shape=(28, 28, 1)),

        tf.keras.layers.Conv2D(32, (3,3), activation='relu'),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Conv2D(64, (3,3), activation='relu'),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Flatten(),
        tf.keras.layers.Dense(128, activation='relu'),
        tf.keras.layers.Dense(10, activation='softmax')
    ])


# =========================
# 4. MODEL Z AUGMENTACJĄ
# =========================
def build_model_aug():
    return tf.keras.models.Sequential([
        data_augmentation,   # <-- KLUCZOWA ZMIANA

        tf.keras.layers.Conv2D(32, (3,3), activation='relu'),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Conv2D(64, (3,3), activation='relu'),
        tf.keras.layers.MaxPooling2D((2,2)),

        tf.keras.layers.Flatten(),
        tf.keras.layers.Dense(128, activation='relu'),
        tf.keras.layers.Dense(10, activation='softmax')
    ])


# =========================
# 5. TRENING
# =========================
def train(model):
    model.compile(
        optimizer=tf.keras.optimizers.Adam(0.001),
        loss='categorical_crossentropy',
        metrics=['accuracy']
    )

    history = model.fit(
        x_train_cnn, y_train_oh,
        epochs=5,
        batch_size=32,
        validation_split=0.2,
        verbose=1
    )

    return history


print("\nTrening bez augmentacji...")
hist_no_aug = train(build_model_no_aug())

print("\nTrening z augmentacją...")
hist_aug = train(build_model_aug())


# =========================
# 6. WYKRES
# =========================
plt.figure(figsize=(10,5))

plt.plot(hist_no_aug.history['val_accuracy'], label='Bez augmentacji')
plt.plot(hist_aug.history['val_accuracy'], label='Z augmentacją')

plt.title("Zadanie E – wpływ augmentacji danych")
plt.xlabel("Epoka")
plt.ylabel("Val Accuracy")
plt.legend()
plt.grid(True)

plt.show()